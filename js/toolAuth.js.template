/**
 * Tool Authentication Configuration
 * This file is auto-generated by GitHub Actions during build
 * For local development, copy this file to toolAuth.js and set your password
 */
const TOOL_PASSWORD = 'changeme'; // Change this for local development

/**
 * Check if user is authenticated
 */
function isAuthenticated() {
    return sessionStorage.getItem('toolAuthenticated') === 'true';
}

/**
 * Authenticate user with password
 */
function authenticate(password) {
    if (password === TOOL_PASSWORD) {
        sessionStorage.setItem('toolAuthenticated', 'true');
        return true;
    }
    return false;
}

/**
 * Logout user
 */
function logout() {
    sessionStorage.removeItem('toolAuthenticated');
}

// Export for use in other modules
if (typeof window !== 'undefined') {
    window.toolAuth = {
        isAuthenticated,
        authenticate,
        logout,
        TOOL_PASSWORD: undefined // Don't expose password
    };
}

